# Copy to .env — loaded by dotenv in development.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
EMAIL_FROM=messy@localhost

API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
# Extra CORS origins for the same SPA under another origin (comma separated),
# e.g. a local reverse proxy in front of the dev server. Optional.
CORS_EXTRA_ORIGINS=
